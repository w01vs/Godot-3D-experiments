[configuration]

entry_symbol = "components_init"
compatibility_minimum = "4.7"
reloadable=true

[libraries]
linux.debug.x86_64 = "res://gdextension/bin/libcomponent.linux.debug.x86_64.so"
linux.release.x86_64 = "res://gdextension/bin/libcomponent.linux.release.x86_64.so"
windows.debug.x86_64 = "res://gdextension/bin/libcomponent.windows.debug.x86_64.dll"
windows.release.x86_64 = "res://gdextension/bin/libcomponent.windows.release.x86_64.dll"
